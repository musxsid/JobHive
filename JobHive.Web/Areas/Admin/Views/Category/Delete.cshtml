@model Category
@{
    ViewData["Title"] = $"Delete {Model.Name}";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white text-center">
                <div class="display-3 text-danger mb-3">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                </div>
                <h3 class="fw-bold text-dark mb-2">Delete Category?</h3>
                <p class="text-muted mb-4">
                    Are you sure you want to remove <strong>@Model.Name</strong>? This action cannot be undone.
                </p>

                <div class="p-3 bg-light rounded-3 text-start mb-4">
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Category Name:</span>
                        <strong class="text-dark">@Model.Name</strong>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Display Order:</span>
                        <strong class="text-dark">@Model.DisplayOrder</strong>
                    </div>
                    <div class="d-flex justify-content-between py-2">
                        <span class="text-muted">Icon Class:</span>
                        <strong class="text-dark">@Model.Icon</strong>
                    </div>
                </div>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-center gap-3">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="bi bi-trash-fill me-1"></i> Confirm Delete
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
