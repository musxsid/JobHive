@model Category
@{
    ViewData["Title"] = "Create Category";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                    <div class="bg-primary-subtle text-primary p-3 rounded-4 fs-3">
                        <i class="bi bi-tag-fill"></i>
                    </div>
                    <div>
                        <span class="badge bg-primary text-white mb-1">Taxonomy Management</span>
                        <h2 class="fw-bold text-dark mb-0">Create New Category</h2>
                    </div>
                </div>

                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-bold">Category Name <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Artificial Intelligence (AI)" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Icon" class="form-label fw-bold">Bootstrap Icon Class</label>
                            <input asp-for="Icon" class="form-control" placeholder="bi-laptop" />
                            <small class="text-muted">e.g. bi-laptop, bi-palette, bi-gear</small>
                            <span asp-validation-for="Icon" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="DisplayOrder" class="form-label fw-bold">Display Order</label>
                            <input asp-for="DisplayOrder" type="number" class="form-control" min="1" max="100" />
                            <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-bold">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Brief explanation of this job category..."></textarea>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Back to Categories
                        </a>
                        <button type="submit" class="btn btn-jh-primary px-4">
                            <i class="bi bi-check2-circle me-1"></i> Save Category
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
