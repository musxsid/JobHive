@model List<Category>
@{
    ViewData["Title"] = "Manage Job Categories";
}

<div class="container py-5 reveal">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <span class="badge bg-primary-subtle text-primary px-3 py-1 rounded-pill fw-bold mb-2">Category Taxonomy</span>
            <h2 class="fw-bold text-dark mb-1">Industry Categories</h2>
            <p class="text-muted mb-0">Total of @Model.Count industry sectors configured for vacancy discovery</p>
        </div>
        <a asp-action="Create" class="btn btn-jh-orange d-inline-flex align-items-center gap-2">
            <i class="bi bi-plus-circle-fill"></i> Add Category
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Icon & Name</th>
                        <th>Description</th>
                        <th>Display Order</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var obj in Model.OrderBy(u => u.DisplayOrder))
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="bg-primary-subtle text-primary rounded-3 p-2 px-3 fs-5">
                                        <i class="bi @(!string.IsNullOrEmpty(obj.Icon) ? obj.Icon : "bi-briefcase")"></i>
                                    </div>
                                    <span class="fw-bold text-dark">@obj.Name</span>
                                </div>
                            </td>
                            <td>
                                <small class="text-muted">@(obj.Description ?? "No description provided")</small>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@obj.DisplayOrder</span>
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group">
                                    <a asp-action="Edit" asp-route-id="@obj.Id" class="btn btn-sm btn-light border" title="Edit">
                                        <i class="bi bi-pencil-fill text-primary"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@obj.Id" class="btn btn-sm btn-light border" title="Delete">
                                        <i class="bi bi-trash-fill text-danger"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
