@model IEnumerable<Job>
@{
    ViewData["Title"] = "System Administration Dashboard";
    var recentApplications = ViewBag.RecentApplications as List<JobApplication> ?? new List<JobApplication>();
}

<div class="container py-5 reveal">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <span class="badge bg-primary-subtle text-primary px-3 py-1 rounded-pill fw-bold mb-2">Administrator Console</span>
            <h2 class="fw-bold text-dark mb-1">System Metrics & Platform Health</h2>
            <p class="text-muted mb-0">High-level operational overview across all vacancies, categories, and applicants</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-area="Admin" asp-controller="Category" asp-action="Index" class="btn btn-jh-outline">
                <i class="bi bi-tags me-1"></i> Manage Categories
            </a>
            <a asp-area="Employer" asp-controller="Job" asp-action="Create" class="btn btn-jh-orange">
                <i class="bi bi-plus-circle me-1"></i> Post Vacancy
            </a>
        </div>
    </div>

    <!-- Stat Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white text-center">
                <div class="display-6 fw-bold text-primary mb-1">@ViewBag.TotalJobs</div>
                <span class="small text-muted text-uppercase fw-bold">Total Vacancies</span>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white text-center">
                <div class="display-6 fw-bold text-success mb-1">@ViewBag.TotalApplications</div>
                <span class="small text-muted text-uppercase fw-bold">Applications Logged</span>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white text-center">
                <div class="display-6 fw-bold text-info mb-1">@ViewBag.TotalCategories</div>
                <span class="small text-muted text-uppercase fw-bold">Industry Sectors</span>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white text-center">
                <div class="display-6 fw-bold text-warning mb-1">@ViewBag.PlacedCandidates</div>
                <span class="small text-muted text-uppercase fw-bold">Offers Extended</span>
            </div>
        </div>
    </div>

    <!-- Recent Applications Table -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-4">
        <div class="p-4 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0 text-dark">Recent Candidate Submissions</h5>
            <span class="badge bg-light text-muted border">Real-time pipeline</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Candidate</th>
                        <th>Applied For</th>
                        <th>Date Submitted</th>
                        <th>Stage</th>
                        <th class="text-end pe-4">Resume</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var app in recentApplications)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold text-dark">@app.ApplicantName</div>
                                <small class="text-muted">@app.ApplicantEmail</small>
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@app.Job?.Title</div>
                                <small class="text-muted">@app.Job?.CompanyName</small>
                            </td>
                            <td>@app.AppliedDate.ToString("MMM dd, yyyy HH:mm")</td>
                            <td>
                                <span class="badge @app.StatusBadgeClass px-3 py-1 rounded-pill">@app.Status</span>
                            </td>
                            <td class="text-end pe-4">
                                @if (!string.IsNullOrEmpty(app.ResumePath))
                                {
                                    <a href="@app.ResumePath" target="_blank" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-download me-1"></i> CV
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

