@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container py-5">
    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
        <h1 class="fw-bold mb-3">Privacy & Candidate Data Protection</h1>
        <p class="text-muted mb-4">Last Updated: August 2025</p>

        <h4 class="fw-bold text-dark mt-3">1. Information Collection</h4>
        <p class="text-secondary">
            JobHive collects information you submit when registering a candidate profile, applying for vacancies, or posting recruitment positions. This includes names, email addresses, phone contacts, resumes/CV documents, and professional portfolios.
        </p>

        <h4 class="fw-bold text-dark mt-3">2. Document Storage & Security</h4>
        <p class="text-secondary">
            Candidate resume documents uploaded to JobHive are secured and accessible only by verified employers who have posted active listings or to whose vacancies the candidate has explicitly applied.
        </p>

        <h4 class="fw-bold text-dark mt-3">3. Database Integrity & Retention</h4>
        <p class="text-secondary">
            All user application interactions are logged with transactional referential integrity in Microsoft SQL Server databases using Entity Framework Core. Data is retained strictly for recruitment workflows and applicant auditing.
        </p>
    </div>
</div>
