@{
    ViewData["Title"] = "About Us";
}

<!-- About Us Header Banner -->
<section class="section-full reveal" style="background: linear-gradient(135deg, rgba(99, 102, 241, 0.08) 0%, rgba(248, 250, 252, 1) 100%);">
    <div class="container py-4">
        <div class="text-center max-w-700 mx-auto mb-5">
            <span class="hero-tagline">
                <i class="bi bi-heart-fill text-danger"></i> Our Mission & Purpose
            </span>
            <h1 class="hero-title" style="font-size: 3.2rem;">
                Empowering Ambitions, Connecting Careers
            </h1>
            <p class="hero-subtitle mx-auto">
                JobHive was designed with one core commitment: to make discovering and applying for jobs seamless, transparent, and rewarding for every career seeker across India.
            </p>
        </div>

        <div class="row g-4 justify-content-center">
            <div class="col-lg-5 col-md-6">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 p-lg-5 bg-white">
                    <div class="brand-icon-box mb-4" style="width: 52px; height: 52px; font-size: 1.5rem;">
                        <i class="bi bi-compass-fill"></i>
                    </div>
                    <h3 class="fw-bold text-dark mb-3">Our Mission</h3>
                    <p class="text-muted leading-relaxed mb-0">
                        To simplify the recruitment journey by providing job seekers with verified employment opportunities, frictionless application tools, and direct visibility into hiring progress.
                    </p>
                </div>
            </div>

            <div class="col-lg-5 col-md-6">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 p-lg-5 bg-white">
                    <div class="brand-icon-box mb-4" style="width: 52px; height: 52px; font-size: 1.5rem; background: linear-gradient(135deg, var(--jh-secondary) 0%, #ea580c 100%);">
                        <i class="bi bi-eye-fill"></i>
                    </div>
                    <h3 class="fw-bold text-dark mb-3">Our Vision</h3>
                    <p class="text-muted leading-relaxed mb-0">
                        To become India's premier and most trusted career ecosystem, bridging the gap between exceptional talent and forward-thinking companies with speed, transparency, and integrity.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- What Makes JobHive Stand Out -->
<section class="section-full reveal bg-white">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="section-title">Why Job Seekers Choose JobHive</h2>
            <p class="section-subtitle">
                Designed to deliver an effortless job hunting and career advancement experience
            </p>
        </div>

        <div class="row g-4">
            <div class="col-lg-3 col-md-6">
                <div class="process-step-card text-start">
                    <div class="category-icon-wrapper bg-primary-subtle text-primary mb-3">
                        <i class="bi bi-funnel-fill"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Smart Discovery</h5>
                    <p class="text-muted small leading-relaxed mb-0">
                        Filter vacancies by specific roles, locations, compensation brackets, and remote options in seconds.
                    </p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="process-step-card text-start">
                    <div class="category-icon-wrapper bg-success-subtle text-success mb-3">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Verified Employers</h5>
                    <p class="text-muted small leading-relaxed mb-0">
                        Every job posting is screened so you can apply with complete confidence to authentic organizations.
                    </p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="process-step-card text-start">
                    <div class="category-icon-wrapper bg-warning-subtle text-warning mb-3">
                        <i class="bi bi-cursor-fill"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">One-Click Applications</h5>
                    <p class="text-muted small leading-relaxed mb-0">
                        Save your master resume and apply to your favorite vacancies with custom cover notes without repetitive uploads.
                    </p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="process-step-card text-start">
                    <div class="category-icon-wrapper bg-info-subtle text-info mb-3">
                        <i class="bi bi-bell-fill"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Real-Time Tracking</h5>
                    <p class="text-muted small leading-relaxed mb-0">
                        Follow each application stage from Under Review to Interview calls through your personal dashboard.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Platform Creator & Community -->
<section class="py-5 reveal" style="background: #f8fafc;">
    <div class="container py-4">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white text-center max-w-700 mx-auto">
            <div class="brand-icon-box mx-auto mb-3" style="width: 56px; height: 56px; font-size: 1.6rem;">
                <i class="bi bi-award-fill"></i>
            </div>
            <h3 class="fw-bold text-dark mb-2">Built with Dedication by Siddharth</h3>
            <p class="text-muted mb-4 leading-relaxed" style="max-width: 560px; margin: 0 auto;">
                JobHive was created with a deep focus on user experience, responsive aesthetics, and robust real-time recruitment management. We continuously evolve to give you the most reliable job hunt experience possible.
            </p>
            <div class="d-flex justify-content-center gap-3">
                <a asp-area="Applicant" asp-controller="Jobs" asp-action="Index" class="btn btn-jh-primary">
                    <i class="bi bi-search me-1"></i> Browse Open Roles
                </a>
                <a asp-area="Applicant" asp-controller="Profile" asp-action="Resume" class="btn btn-jh-outline">
                    <i class="bi bi-file-earmark-person me-1"></i> Manage Your Resume
                </a>
            </div>
        </div>
    </div>
</section>
