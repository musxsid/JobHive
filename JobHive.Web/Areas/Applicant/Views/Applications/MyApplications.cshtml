@model IEnumerable<JobApplication>
@{
    ViewData["Title"] = "My Job Applications";
}

<div class="container py-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <span class="badge bg-primary-subtle text-primary px-3 py-1 rounded-pill fw-bold mb-2">Candidate Dashboard</span>
            <h2 class="fw-bold text-dark mb-1">My Submitted Applications</h2>
            <p class="text-muted mb-0">Track the real-time recruitment progression of your job applications</p>
        </div>
        <a asp-area="Applicant" asp-controller="Jobs" asp-action="Index" class="btn btn-jh-primary">
            <i class="bi bi-search me-1"></i> Browse More Vacancies
        </a>
    </div>

    @if (Model.Any())
    {
        <div class="row g-4">
            @foreach (var app in Model)
            {
                <div class="col-lg-6">
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100 position-relative">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <h5 class="fw-bold mb-1">
                                    <a asp-area="Applicant" asp-controller="Jobs" asp-action="Details" asp-route-id="@app.JobId" class="text-dark text-decoration-none">
                                        @app.Job?.Title
                                    </a>
                                </h5>
                                <div class="text-muted small">
                                    <i class="bi bi-building me-1"></i> @app.Job?.CompanyName &bull; <i class="bi bi-geo-alt me-1"></i> @app.Job?.Location
                                </div>
                            </div>
                            <span class="badge @app.StatusBadgeClass fs-6 px-3 py-2 rounded-pill">
                                @app.Status
                            </span>
                        </div>

                        <!-- Recruitment Workflow Progression Stepper -->
                        <div class="p-3 rounded-3 bg-light mb-3">
                            <div class="d-flex justify-content-between text-center small position-relative">
                                <div class="flex-fill @(app.Status == "Applied" || app.Status == "Under Review" || app.Status == "Shortlisted" || app.Status == "Interview" || app.Status == "Offered" ? "fw-bold text-primary" : "text-muted")">
                                    <i class="bi bi-check-circle-fill d-block mb-1"></i> Applied
                                </div>
                                <div class="flex-fill @(app.Status == "Under Review" || app.Status == "Shortlisted" || app.Status == "Interview" || app.Status == "Offered" ? "fw-bold text-info" : "text-muted")">
                                    <i class="bi @(app.Status == "Under Review" || app.Status == "Shortlisted" || app.Status == "Interview" || app.Status == "Offered" ? "bi-check-circle-fill" : "bi-circle") d-block mb-1"></i> Review
                                </div>
                                <div class="flex-fill @(app.Status == "Interview" || app.Status == "Offered" ? "fw-bold text-secondary" : "text-muted")">
                                    <i class="bi @(app.Status == "Interview" || app.Status == "Offered" ? "bi-check-circle-fill" : "bi-circle") d-block mb-1"></i> Interview
                                </div>
                                <div class="flex-fill @(app.Status == "Offered" ? "fw-bold text-success" : (app.Status == "Rejected" ? "fw-bold text-danger" : "text-muted"))">
                                    <i class="bi @(app.Status == "Offered" ? "bi-patch-check-fill" : (app.Status == "Rejected" ? "bi-x-circle-fill" : "bi-circle")) d-block mb-1"></i>
                                    @(app.Status == "Rejected" ? "Decision" : "Offered")
                                </div>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(app.RecruiterNotes))
                        {
                            <div class="alert alert-info py-2 px-3 small mb-3">
                                <i class="bi bi-chat-left-text-fill me-1"></i> <strong>Recruiter Remarks:</strong> @app.RecruiterNotes
                            </div>
                        }

                        <div class="d-flex justify-content-between align-items-center pt-2 mt-auto border-top text-muted small">
                            <span><i class="bi bi-calendar3 me-1"></i> Applied: @app.AppliedDate.ToString("MMM dd, yyyy")</span>
                            @if (!string.IsNullOrEmpty(app.ResumePath))
                            {
                                <a href="@app.ResumePath" target="_blank" class="text-primary text-decoration-none fw-semibold">
                                    <i class="bi bi-file-earmark-pdf me-1"></i> View Resume
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 bg-white text-center">
            <div class="display-3 text-muted mb-3"><i class="bi bi-journal-x"></i></div>
            <h4 class="fw-bold text-dark">No applications submitted yet</h4>
            <p class="text-muted mb-4">Start discovering verified vacancies and submit your first application today.</p>
            <a asp-area="Applicant" asp-controller="Jobs" asp-action="Index" class="btn btn-jh-primary mx-auto">
                <i class="bi bi-search me-1"></i> Explore Open Vacancies
            </a>
        </div>
    }
</div>

