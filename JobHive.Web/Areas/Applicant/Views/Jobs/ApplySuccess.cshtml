@model JobApplication
@{
    ViewData["Title"] = "Application Submitted Successfully";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 p-5 bg-white text-center">
                <div class="display-3 text-success mb-3">
                    <i class="bi bi-patch-check-fill"></i>
                </div>
                <h2 class="fw-bold text-dark mb-2">Application Submitted!</h2>
                <p class="lead text-muted mb-4">
                    Your application for <strong>@Model.Job?.Title</strong> at <strong>@Model.Job?.CompanyName</strong> has been registered with 100% referential transactional integrity.
                </p>

                <div class="p-4 rounded-4 bg-light border text-start mb-4">
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Application Reference:</span>
                        <strong class="text-dark">#JH-@Model.Id-@Model.JobId</strong>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Candidate Name:</span>
                        <strong class="text-dark">@Model.ApplicantName</strong>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Submission Date:</span>
                        <strong class="text-dark">@Model.AppliedDate.ToString("f")</strong>
                    </div>
                    <div class="d-flex justify-content-between py-2">
                        <span class="text-muted">Current Stage:</span>
                        <span class="badge @Model.StatusBadgeClass">@Model.Status</span>
                    </div>
                </div>

                <div class="d-flex justify-content-center gap-3">
                    <a asp-area="Applicant" asp-controller="Applications" asp-action="MyApplications" class="btn btn-jh-primary">
                        <i class="bi bi-send-check me-1"></i> Track in 'My Applications'
                    </a>
                    <a asp-area="Applicant" asp-controller="Jobs" asp-action="Index" class="btn btn-outline-secondary">
                        Browse More Vacancies
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

