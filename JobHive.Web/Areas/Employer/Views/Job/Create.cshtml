@model Job
@{
    ViewData["Title"] = "Post a New Vacancy";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                    <div class="bg-primary-subtle text-primary p-3 rounded-4 fs-3">
                        <i class="bi bi-briefcase-fill"></i>
                    </div>
                    <div>
                        <span class="badge bg-primary text-white mb-1">Recruiter Portal</span>
                        <h2 class="fw-bold text-dark mb-0">Post a New Vacancy</h2>
                        <small class="text-muted">Fill in specifications to connect with qualified job seekers</small>
                    </div>
                </div>

                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row g-3 mb-4">
                        <!-- Job Title -->
                        <div class="col-md-8">
                            <label asp-for="Title" class="form-label fw-bold">Job Title <span class="text-danger">*</span></label>
                            <input asp-for="Title" class="form-control" placeholder="e.g. Senior .NET Core Software Engineer" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <!-- Category -->
                        <div class="col-md-4">
                            <label asp-for="CategoryId" class="form-label fw-bold">Category <span class="text-danger">*</span></label>
                            <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId">
                                <option value="">Select Category</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>

                        <!-- Company Name -->
                        <div class="col-md-6">
                            <label asp-for="CompanyName" class="form-label fw-bold">Company / Employer Name <span class="text-danger">*</span></label>
                            <input asp-for="CompanyName" class="form-control" placeholder="e.g. CodeArrest Softwares" />
                            <span asp-validation-for="CompanyName" class="text-danger small"></span>
                        </div>

                        <!-- Recruiter Email -->
                        <div class="col-md-6">
                            <label asp-for="EmployerEmail" class="form-label fw-bold">Recruiter Email <span class="text-danger">*</span></label>
                            <input asp-for="EmployerEmail" type="email" class="form-control" placeholder="careers@codearrest.com" />
                            <span asp-validation-for="EmployerEmail" class="text-danger small"></span>
                        </div>

                        <!-- Location -->
                        <div class="col-md-8">
                            <label asp-for="Location" class="form-label fw-bold">Location <span class="text-danger">*</span></label>
                            <input asp-for="Location" class="form-control" placeholder="e.g. Bangalore, India" />
                            <span asp-validation-for="Location" class="text-danger small"></span>
                        </div>

                        <!-- Remote Checkbox -->
                        <div class="col-md-4 d-flex align-items-center">
                            <div class="form-check form-switch mt-4">
                                <input asp-for="IsRemote" class="form-check-input" type="checkbox" id="remoteSwitch" />
                                <label class="form-check-label fw-bold" for="remoteSwitch">Remote Work Available</label>
                            </div>
                        </div>

                        <!-- Job Type -->
                        <div class="col-md-6">
                            <label asp-for="JobType" class="form-label fw-bold">Job Type</label>
                            <select asp-for="JobType" class="form-select">
                                <option value="@SD.JobType_FullTime">Full-Time</option>
                                <option value="@SD.JobType_PartTime">Part-Time</option>
                                <option value="@SD.JobType_Remote">Remote</option>
                                <option value="@SD.JobType_Contract">Contract</option>
                                <option value="@SD.JobType_Internship">Internship</option>
                            </select>
                            <span asp-validation-for="JobType" class="text-danger small"></span>
                        </div>

                        <!-- Experience Level -->
                        <div class="col-md-6">
                            <label asp-for="ExperienceLevel" class="form-label fw-bold">Experience Level</label>
                            <select asp-for="ExperienceLevel" class="form-select">
                                <option value="@SD.Exp_Entry">Entry Level (0-2 years)</option>
                                <option value="@SD.Exp_Mid">Mid Level (2-5 years)</option>
                                <option value="@SD.Exp_Senior">Senior Level (5+ years)</option>
                                <option value="@SD.Exp_Lead">Lead / Managerial</option>
                            </select>
                            <span asp-validation-for="ExperienceLevel" class="text-danger small"></span>
                        </div>

                        <!-- Salary Range -->
                        <div class="col-md-6">
                            <label asp-for="SalaryMin" class="form-label fw-bold">Minimum Annual Salary (₹)</label>
                            <input asp-for="SalaryMin" type="number" step="50000" class="form-control" placeholder="800000" />
                            <span asp-validation-for="SalaryMin" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="SalaryMax" class="form-label fw-bold">Maximum Annual Salary (₹)</label>
                            <input asp-for="SalaryMax" type="number" step="50000" class="form-control" placeholder="1500000" />
                            <span asp-validation-for="SalaryMax" class="text-danger small"></span>
                        </div>

                        <!-- Description -->
                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-bold">Job Description <span class="text-danger">*</span></label>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Detailed overview of the role, team, and expectations..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <!-- Responsibilities -->
                        <div class="col-12">
                            <label asp-for="Responsibilities" class="form-label fw-bold">Key Responsibilities</label>
                            <textarea asp-for="Responsibilities" class="form-control" rows="3" placeholder="• Design scalable backend microservices&#10;• Profile SQL queries for optimal execution time"></textarea>
                        </div>

                        <!-- Requirements -->
                        <div class="col-12">
                            <label asp-for="Requirements" class="form-label fw-bold">Requirements & Qualifications</label>
                            <textarea asp-for="Requirements" class="form-control" rows="3" placeholder="• 3+ years experience with C# and .NET Core&#10;• Deep understanding of Entity Framework Core"></textarea>
                        </div>

                        <!-- Benefits -->
                        <div class="col-12">
                            <label asp-for="Benefits" class="form-label fw-bold">Perks & Benefits</label>
                            <textarea asp-for="Benefits" class="form-control" rows="2" placeholder="Flexible hours, Comprehensive health insurance, Annual learning budget"></textarea>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-jh-orange px-4 py-2">
                            <i class="bi bi-check2-circle me-1"></i> Publish Vacancy
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
