@model Job
@{
    ViewData["Title"] = $"Edit {Model.Title}";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                    <div class="bg-primary-subtle text-primary p-3 rounded-4 fs-3">
                        <i class="bi bi-pencil-square"></i>
                    </div>
                    <div>
                        <span class="badge bg-primary text-white mb-1">Vacancy Editor</span>
                        <h2 class="fw-bold text-dark mb-0">Update Job Specifications</h2>
                        <small class="text-muted">Modify vacancy details and criteria</small>
                    </div>
                </div>

                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="PostedDate" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-8">
                            <label asp-for="Title" class="form-label fw-bold">Job Title <span class="text-danger">*</span></label>
                            <input asp-for="Title" class="form-control" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="CategoryId" class="form-label fw-bold">Category <span class="text-danger">*</span></label>
                            <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId"></select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CompanyName" class="form-label fw-bold">Company Name <span class="text-danger">*</span></label>
                            <input asp-for="CompanyName" class="form-control" />
                            <span asp-validation-for="CompanyName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="EmployerEmail" class="form-label fw-bold">Recruiter Email <span class="text-danger">*</span></label>
                            <input asp-for="EmployerEmail" type="email" class="form-control" />
                            <span asp-validation-for="EmployerEmail" class="text-danger small"></span>
                        </div>

                        <div class="col-md-8">
                            <label asp-for="Location" class="form-label fw-bold">Location <span class="text-danger">*</span></label>
                            <input asp-for="Location" class="form-control" />
                            <span asp-validation-for="Location" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4 d-flex align-items-center">
                            <div class="form-check form-switch mt-4">
                                <input asp-for="IsRemote" class="form-check-input" type="checkbox" id="remoteSwitch" />
                                <label class="form-check-label fw-bold" for="remoteSwitch">Remote Available</label>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="JobType" class="form-label fw-bold">Job Type</label>
                            <select asp-for="JobType" class="form-select">
                                <option value="@SD.JobType_FullTime">Full-Time</option>
                                <option value="@SD.JobType_PartTime">Part-Time</option>
                                <option value="@SD.JobType_Remote">Remote</option>
                                <option value="@SD.JobType_Contract">Contract</option>
                                <option value="@SD.JobType_Internship">Internship</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ExperienceLevel" class="form-label fw-bold">Experience Level</label>
                            <select asp-for="ExperienceLevel" class="form-select">
                                <option value="@SD.Exp_Entry">Entry Level</option>
                                <option value="@SD.Exp_Mid">Mid Level</option>
                                <option value="@SD.Exp_Senior">Senior Level</option>
                                <option value="@SD.Exp_Lead">Lead / Managerial</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="SalaryMin" class="form-label fw-bold">Minimum Salary (₹)</label>
                            <input asp-for="SalaryMin" type="number" step="50000" class="form-control" />
                            <span asp-validation-for="SalaryMin" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="SalaryMax" class="form-label fw-bold">Maximum Salary (₹)</label>
                            <input asp-for="SalaryMax" type="number" step="50000" class="form-control" />
                            <span asp-validation-for="SalaryMax" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-bold">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Responsibilities" class="form-label fw-bold">Responsibilities</label>
                            <textarea asp-for="Responsibilities" class="form-control" rows="3"></textarea>
                        </div>

                        <div class="col-12">
                            <label asp-for="Requirements" class="form-label fw-bold">Requirements</label>
                            <textarea asp-for="Requirements" class="form-control" rows="3"></textarea>
                        </div>

                        <div class="col-12">
                            <label asp-for="Benefits" class="form-label fw-bold">Benefits</label>
                            <textarea asp-for="Benefits" class="form-control" rows="2"></textarea>
                        </div>

                        <div class="col-md-6">
                            <div class="form-check form-switch mt-2">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" id="activeSwitch" />
                                <label class="form-check-label fw-bold" for="activeSwitch">Listing is Active</label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Back to Vacancies
                        </a>
                        <button type="submit" class="btn btn-jh-primary px-4 py-2">
                            <i class="bi bi-save me-1"></i> Update Specifications
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

